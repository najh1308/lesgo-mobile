# Salin file ini menjadi .env lalu isi sesuai laptop kalian.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lesgo
DB_USER=root
DB_PASS=
TOKEN_TTL_DAYS=7
APP_DEBUG=true

# Tutor AI (LLM). Bawaan memakai Google Gemini (ada kuota gratis).
# Buat API key di https://aistudio.google.com/apikey lalu tempel di bawah.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Alternatif: penyedia yang kompatibel dengan OpenAI (Groq, OpenRouter, dll).
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=
